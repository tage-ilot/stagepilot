{
  "$schema": "https://schema.tauri.app/config/2",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tage-ilot/stagepilot/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "generated-help/StagePilot.help/": "StagePilot.help/",
      "resources/cloudflared": "cloudflared",
      "../../frontend/dist/": "stagepilot_web/"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "12.0"
    }
  }
}
